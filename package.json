{
  "name": "montesquad-api",
  "version": "1.0.0",
  "description": "MonteSquad API em Node JS utilizando Express e MySQL para TCC",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:setup": "node scripts/migrar_fase01.js && node scripts/migrar_fase02.js && node scripts/migrar_avatar_url.js",
    "db:github": "node scripts/migrar_github_integracao.js",
    "db:etapa3": "node scripts/migrar_evolucao_etapa3.js",
    "db:etapa4": "node scripts/migrar_evolucao_etapa4.js",
    "db:etapa5": "node scripts/migrar_evolucao_etapa5.js",
    "db:etapa6": "node scripts/migrar_evolucao_etapa6.js",
    "db:etapa7": "node scripts/migrar_evolucao_etapa7.js",
    "db:etapa9": "node scripts/migrar_evolucao_etapa9.js",
    "db:etapa10": "node scripts/migrar_evolucao_etapa10.js",
    "db:etapa12": "node scripts/migrar_evolucao_etapa12.js",
    "db:etapa14": "node scripts/migrar_evolucao_etapa14.js",
    "db:etapa15": "node scripts/migrar_evolucao_etapa15.js",
    "db:seguranca": "node scripts/migrar_seguranca_tokens_revogados.js"
  },
  "keywords": [
    "Node JS",
    "API",
    "MySQL",
    "Express"
