  "author": "Matheus Ribeiro",
  "license": "MIT",
  "dependencies": {
    "@octokit/app": "^16.1.4",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks": "^14.2.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.12.0",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "nodemon": "3.1.9",
    "supertest": "^7.2.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
