# ============================================================
# MontesSquad-API — Exemplo de variáveis de ambiente
# Copie este arquivo para `.env` e preencha com valores REAIS.
# NUNCA commite o `.env` (ele contém segredos).
# ============================================================

# --- Banco de dados (MySQL) ---
BD_SERVIDOR=localhost
BD_PORTA=3306
BD_USUARIO=usuario_do_banco
BD_SENHA=senha_do_banco
BD_BANCO=montesquad

# --- Servidor ---
PORT=3333
NODE_ENV=development

# --- CORS (origens permitidas no frontend, separadas por vírgula) ---
FRONTEND_URL=http://localhost:5173

# --- JWT ---
JWT_SECRET=troque-por-um-segredo-forte-aleatorio
JWT_RESET_SECRET=troque-por-outro-segredo-forte-aleatorio
JWT_EXPIRES_IN=8h
JWT_RESET_EXPIRES_IN=15m

# --- Envio de e-mails (Mailtrap API ou SMTP tradicional) ---
# Opção 1: Mailtrap API (https://send.api.mailtrap.io)
MAILTRAP_API_TOKEN=
MAILTRAP_FROM_EMAIL=hello@demomailtrap.co
MAILTRAP_FROM_NAME=MontesSquad

# Opção 2: SMTP tradicional (Hostinger)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=seu_email@seudominio.com
SMTP_PASSWORD=sua_senha
SMTP_SECURE=true
SMTP_FROM=MontesSquad <seu_email@seudominio.com>

# --- Recuperação de senha: URL do frontend que recebe o token no query string ---
RESET_PASSWORD_URL=http://localhost:5173/resetar-senha?token=

# --- GitHub App (integração GitHub-Kanban, ETAPA 3+) ---
# App criado em https://github.com/settings/apps
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Private key PEM gerada no GitHub App (o \n literal pode ser usado no .env; o
# serviço normaliza para quebras de linha reais). NUNCA commitar.
GITHUB_PRIVATE_KEY=
# Secret configurado no webhook do GitHub App
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=
GITHUB_CALLBACK_URL=http://localhost:3333/github/callback
GITHUB_FRONTEND_SUCCESS_URL=http://localhost:5173
GITHUB_AUTH_CALLBACK_URL=http://localhost:3333/auth/github/callback
