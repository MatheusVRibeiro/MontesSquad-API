# ============================================================
# MontesSquad-API — Exemplo de variáveis de ambiente
# Copie este arquivo para `.env` e preencha com valores REAIS.
# NUNCA commite o `.env` (ele contém segredos).
# ============================================================

# --- Banco de dados (MySQL) ---
BD_SERVIDOR=localhost
BD_PORTA=3306
BD_USUARIO=usuario_do_banco
BD_SENHA=senha_do_banco
BD_BANCO=montesquad

# --- Servidor ---
PORT=3333
NODE_ENV=development

# --- CORS (origens permitidas no frontend, separadas por vírgula) ---
FRONTEND_URL=http://localhost:5173

# --- JWT ---
JWT_SECRET=troque-por-um-segredo-forte-aleatorio
JWT_RESET_SECRET=troque-por-outro-segredo-forte-aleatorio
JWT_EXPIRES_IN=8h
JWT_RESET_EXPIRES_IN=15m

# --- SMTP (envio de e-mails de recuperação de senha) ---
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=usuario@smtp.exemplo.com
SMTP_PASSWORD=senha_smtp
SMTP_SECURE=false
SMTP_FROM=MontesSquad <nao-responder@exemplo.com>

# --- Recuperação de senha: URL do frontend que recebe o token no query string ---
RESET_PASSWORD_URL=http://localhost:5173/resetar-senha?token=
